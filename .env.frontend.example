# Template for the public web host (frontend + auth). Copy to .env next to
# compose.frontend.yml. The Authentik section only matters if compose.authentik.yml
# runs on this host too.

# Authenticates requests to the backend; must match the backend's secret exactly
FRONTEND_SECRET=change-this-to-a-secure-random-string

# The public-facing port for the web interface
FRONTEND_PORT=8080

# The network address of the backend host
BACKEND_URL=http://X.X.X.X:8000

# Directory to persist authentication data
AUTH_DATA_DIR=./data/auth

# Bypasses OIDC and grants an admin session (local development only)
DEV_AUTH=false

# OIDC provider configuration (Authentik application "deeplabel"). People sign in on
# DeepLabel's own page and never see Authentik: the auth service runs Authentik's login
# flow itself and completes the authorization with this client.
OIDC_ISSUER=http://your-server-ip:9000/application/o/deeplabel/
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Must be one of the provider's redirect URIs. Nothing is ever sent there: the auth service
# reads the authorization code off Authentik's redirect towards it.
OIDC_REDIRECT_URI=http://your-server-ip:8080/api/auth/callback
# Where the auth service reaches Authentik, when OIDC_ISSUER's public address is not
# reachable from inside its container - e.g. behind tailscale serve, whose listeners
# containers cannot connect to (tailscale 1.104+). Its calls go here with the public host
# in the headers, so Authentik still answers as itself. Usually the Authentik container
# on the Docker network:
#OIDC_INTERNAL_URL=http://deeplabel-authentik:9000

# Subject claim of the user who becomes the first admin. With the provider's
# subject mode set to "based on username" this is simply the username.
INITIAL_ADMIN_SUBJECT=

# Lets DeepLabel manage accounts in Authentik: invitations and password-reset links on
# the Admin page, Change password on the profile, sign-up, and rejecting a sign-up.
# Empty keeps all of that off. Use the token of a service account with only the
# permissions AUTHENTIK.md lists ("Managing accounts from DeepLabel"), never an admin's.
# Authentik is called at OIDC_ISSUER's host.
AUTHENTIK_API_TOKEN=

# Lets people make their own account from the sign-in page. A new account can sign in
# but only sees a waiting page until an admin approves it on the Admin page. Needs
# AUTHENTIK_API_TOKEN.
SELF_SIGN_UP=false

# Ensures cookies are only sent over HTTPS (set to false for local HTTP dev)
SESSION_COOKIE_SECURE=true

# --------AUTHENTIK--------

AUTHENTIK_TAG=2026.2
AUTHENTIK_PORT=9000
AUTHENTIK_DATA_DIR=./data/authentik
AUTHENTIK_SECRET_KEY=generate-with-openssl-rand-base64-48
AUTHENTIK_PG_PASSWORD=generate-with-openssl-rand-base64-24
# First-boot only: credentials for the akadmin superuser and an API token used
# to bootstrap the OIDC provider; can be removed after setup.
AUTHENTIK_BOOTSTRAP_PASSWORD=
AUTHENTIK_BOOTSTRAP_TOKEN=

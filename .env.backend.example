# Template for the GPU backend host. Copy to .env next to compose.backend.yml.

# Authenticates requests from the frontend; must match the frontend's secret exactly.
# It is a master key: whoever holds it can call the API as any username in any role,
# so keep the port it guards as private as the deployment allows (BACKEND_BIND below).
FRONTEND_SECRET=change-this-to-a-secure-random-string

# Which host interface publishes the backend port.
#   0.0.0.0   - reachable from other machines. Needed when the frontend runs on another
#               host, and when it reaches the backend through host.docker.internal.
#   127.0.0.1 - localhost only. Correct when the frontend shares this host and talks to
#               the backend over the compose network (BACKEND_URL=http://backend:8000),
#               which leaves no remotely usable door behind FRONTEND_SECRET.
# A tailnet or VPN address works too when the frontend is remote but the link is private.
BACKEND_BIND=0.0.0.0

# The commit the backend image is built from, shown with the version on your profile and at
# /api/meta. Set it for the build rather than here, so it cannot go stale:
#   GIT_COMMIT=$(git rev-parse --short HEAD) docker compose -f compose.backend.yml up -d --build
# GIT_COMMIT=

# Which job kinds this deployment offers. A disabled task disappears from the New job
# picker and is refused by the API; jobs of that kind created earlier keep working, so
# switching one off never strands existing data. All default to true.
ENABLE_TEXT=true
ENABLE_MAP_SEGMENTATION=true
ENABLE_MAP_LINES=true

# Upload guards, so a runaway file fails at once with a message naming it and the limit
# instead of filling the disk or the memory of the ingest phase. A zip export is refused
# when the sizes its own index declares add up to more than MAX_ZIP_EXTRACT_GB, before
# anything is written. An image (uploaded, or inside an export) is refused above
# MAX_IMAGE_PIXELS, width times height: one gigapixel decodes to about 3 GB of RGB, which
# still takes a large cadastral map sheet. A PDF page is measured as the image it becomes:
# an extracted scan by its own pixels, a rendered page by its size at PDF_RENDER_DPI.
# 0 switches a guard off.
#MAX_ZIP_EXTRACT_GB=50
#MAX_IMAGE_PIXELS=1000000000

# Which folders on the backend host a dataset may be read from by server path (admins
# only). Comma-separated absolute paths, as the backend sees them - inside the container
# that is the mount target, not the host path. A server path must lie inside one of them;
# empty allows any absolute path. Symbolic links to folders are never followed, and links
# to files outside these folders are skipped; both are named in the response.
#INGEST_ROOTS=/data/scans,/mnt/nas/archive

# Controls whether corrected OCR lines are archived as training pairs
SAVE_OCR_DATA=true

# Pages sent to the layout backend per request.
LAYOUT_BATCH_SIZE=4

# Paint out everything outside a line's own polygon before cropping it, so a line is not
# handed the neighbours' ink from the corners of its bounding rectangle. Only bites where a
# polygon is not a tight rectangle - about 0.6% of lines, the hand-traced ones - and leaves
# every other crop byte-identical. One crop feeds training, evaluation, OCR and the loupe,
# so turning it off turns it off for all four.
LINE_CROP_MASK=true

# --- LLM pre-annotation (optional) ---
# Whole-page transcription by language models, set up per person under Settings. Any
# OpenAI-compatible endpoint works - a self-hosted vLLM or Ollama, or a hosted provider's
# compatibility URL - so nothing here names a vendor.
# Off removes the feature from the UI and refuses its routes, which is how a deployment
# holding restricted material guarantees no scan is ever handed to a third party.
ENABLE_LLM_OCR=true
# Encrypts the API keys people save, which live in app.db. Any string; the encryption key
# is derived from it. Changing it makes every stored key unreadable - the UI then asks for
# them again rather than failing at the provider. Leave it unset and no key can be stored
# at all: endpoints that need no credential still work, everything else is refused.
#LLM_SECRET_KEY=change-this-to-a-secure-random-string
# How long one page read may take. A page is a large image and a long generation, and a
# model reached through a broker such as OpenRouter can wait in its queue for minutes
# before generating a token, so this is generous by design. Lower it only if you would
# rather a slow provider fail than hold one of the LLM_MAX_CONCURRENCY slots.
#LLM_TIMEOUT=600
# Pages read in parallel. Raising it meets a provider's rate limit long before it troubles
# this host.
#LLM_MAX_CONCURRENCY=4

# --- Map-segmentation pre-annotation (optional) ---
# Optional: the whole section can stay unset. The model code is the cadastre_segmentation
# repo's inference/ package; point MAPSEG_ROOT at it. Unset mounts an empty directory instead, and the New dataset form then
# shows map tiling / pre-annotation switched off with the reason (the API refuses them too);
# everything else, annotation-only tile jobs included, runs.
# MAPSEG_ROOT=/path/to/cadastre_segmentation
# Interpreter with torch + segmentation-models-pytorch + transformers + cv2 + rasterio (see
# $MAPSEG_ROOT/requirements-inference.txt). Leave empty to disable tiling and prediction -
# the form switches both off and says why. The app venv is torch-free, so this must be a
# separate interpreter.
# MAPSEG_PYTHON=/path/to/torch-venv/bin/python
# Model registry: the available checkpoints + their class vocabularies. Add a model by
# dropping a .pth next to it and adding one entry to registry.json.
# MAPSEG_REGISTRY=/models/mapseg/registry.json
# Fallback checkpoint when a job has no model / the registry is absent.
# MAPSEG_CHECKPOINT=/models/mapseg/cadastre_upernet.pth
# Model windows per forward pass (a tile larger than the model's input is several). Lower
# it if prediction runs out of VRAM.
# MAPSEG_BATCH_SIZE=4
# Polygon simplification applied to the predicted mask, in pixels of the tile at its full
# resolution: higher means fewer vertices to correct but coarser outlines.
# MAPSEG_EPSILON=2.0
# Predicted shapes smaller than this area (px²) are dropped as speckle rather than
# becoming regions an annotator has to delete by hand.
# MAPSEG_MIN_AREA=12

# --- Edge detection for the area-detect tool (optional) ---
# The tile editor's Detect tool traces the edges inside a selected area of a line-tracing
# job's tile. The detectors are the edge_detection repo's detect/ package; point
# EDGE_DETECT_ROOT at it.
# EDGE_DETECT_ROOT=/path/to/edge_detection_repo
# Interpreter with OpenCV + numpy (and torch, once the learned methods land) — see
# $EDGE_DETECT_ROOT/requirements.txt. Leave empty to disable detection: the tool then says
# it is unavailable instead of failing, and hand tracing is unaffected. The app venv has
# no OpenCV, so this must be a separate interpreter.
# EDGE_DETECT_PYTHON=/path/to/edge_detection_repo/.venv/bin/python
# Method registry: which detectors are offered and what parameters they take. Add one by
# implementing it in the repo and adding an entry here with the same id.
# EDGE_REGISTRY=/models/edge/registry.json
# How long one detection may take before it is abandoned. A selection is interactive work;
# anything slower than this belongs in the job queue, not in a click.
# EDGE_DETECT_TIMEOUT=30

# Model backends (docs/MODEL-BACKENDS.md): each model type as an HTTP service of its own.
# A model reads, and a run fine-tuning it trains, on its backend; a model whose backend has
# no URL here cannot read or train. An admin can point one model at another backend with
# PATCH /api/models/<id> {"backend": "<name>"}. Name
# each backend, then give it a URL and a secret of its own (`openssl rand -hex 32`); the
# backend is started with the same secret as its MODEL_BACKEND_SECRET. A model row with no
# backend of its own belongs to the backend named after its task (layout, lines, ocr,
# mapseg for map segmentation, edges), and a backend may fetch only its own models' files.
# MODEL_BACKENDS=ocr,layout
# MODEL_BACKEND_OCR_URL=http://ocr-backend:9100
# MODEL_BACKEND_OCR_SECRET=
# Backends sharing a GPU group run one at a time, and each frees the card of the others'
# loaded models before it loads or trains, so models on one card never compete.
# MODEL_BACKEND_OCR_GPU_GROUP=default
# For cluster training on the backend: the .sqsh image of it, placed on the cluster by hand,
# that the generic job script runs the backend's training entrypoint in. Without it, a
# cluster run of a model on this backend is refused rather than trained some other way.
# MODEL_BACKEND_OCR_CLUSTER_IMAGE=/scratch/deeplabel/images/deepocr-backend-2026.10.sqsh
# (deeplabel-backends' cluster-image.sh makes that file from a built image.)
# Line models beside the task's own: RF-DETR line segmentation and Kraken each run as a
# backend of their own name; a lines model imported with --backend rfdetr-lines or kraken
# reads and trains there.
# MODEL_BACKEND_RFDETR_LINES_URL=http://deepsegment-rfdetr:9100
# MODEL_BACKEND_RFDETR_LINES_SECRET=
# MODEL_BACKEND_KRAKEN_URL=http://kraken:9100
# MODEL_BACKEND_KRAKEN_SECRET=
# The address backends reach this API at, put into every file URL they are handed.
# MODEL_BACKEND_FETCH_URL=http://deeplabel-backend:8000
# compose.models.yml runs an OCR and a lines backend beside this one, from images built in
# deeplabel-backends (build.sh prints the tag): start it with
# docker compose -f compose.backend.yml -f compose.models.yml up -d, and set
# MODEL_BACKENDS=ocr,lines, MODEL_BACKEND_OCR_URL=http://ocr:9100,
# MODEL_BACKEND_LINES_URL=http://lines:9100 and MODEL_BACKEND_FETCH_URL=http://backend:8000.
# A backend that ships its own weights becomes its task's default model the first time
# DeepLabel reaches it, unless another model already is.
# OCR_BACKEND_IMAGE=deepocr-backend:<tag>
# LINES_BACKEND_IMAGE=kraken-lines-backend:<tag>
# Each backend's model cache, in GB.
# OCR_BACKEND_CACHE_GB=20
# LINES_BACKEND_CACHE_GB=5
# How long a backend may take to download and load a model, and one predict request, in s.
# MODEL_BACKEND_LOAD_TIMEOUT=1800
# MODEL_BACKEND_PREDICT_TIMEOUT=600
# Where the weight store keeps model files by content. Fill it from the existing model
# rows once with `docker exec deeplabel-backend python -m app.weights import-existing`.
# WEIGHTS_DIR=/data/weights

# External SLURM cluster for training runs; unset SLURM_HOST disables the target
#SLURM_HOST=cluster.example.org
#SLURM_USER=youruser
#SLURM_PARTITION=compute
# Fallback account jobs are charged to. Each person can be given their own under Admin,
# which wins over this - every job submits under the one SLURM_USER, so the account plus
# the submitter's name in --comment is the only way sacct can tell runs apart.
#SLURM_ACCOUNT=youraccount
#SLURM_GRES=gpu:2
# The GPU cards a run may pick, as name:max[:partition]: the gres name, the most of them one
# node has, and the partition they live on when it is not SLURM_PARTITION. Unset offers no
# choice of card; every run then asks for SLURM_GRES.
#SLURM_GPUS=h200:8,a100:4:gpu-a100
# The most CPUs and host RAM one job may ask for, whatever its GPU count.
#SLURM_CPUS=16
#SLURM_MEM=64G
# What one GPU's rank actually needs; the request is this times the GPU count, capped by
# the two above. The cluster charges for what a job asks for, so a fixed per-job request
# makes every small run pay for the largest one. Both scale with the batch as well as the
# GPU count: each rank stages workers x prefetch x batch samples in host memory before
# they reach the card, so a batch sized to fill a 140 GB GPU can still be SIGKILLed by the
# host OOM killer at a figure that was fine at batch 32. Budget CPUs for the rank plus its
# dataloader workers, and RAM well above the staged sample volume: a 2 x H200 run at batch
# 76 measured 7 cores busy and 158 GB peak across both ranks, so 128G a GPU leaves half
# again as much as it took - a run SIGKILLed hours in costs far more than the margin.
# A run on a model backend asks for what that backend declares per GPU (cpus_per_gpu,
# memory_per_gpu_gb) instead; these two are for runs whose backend declares nothing.
#SLURM_CPUS_PER_GPU=12
#SLURM_MEM_PER_GPU=128G
# Walltime. Empty takes the partition default, which is easy to read as "no limit" when
# the partition's MaxTime is UNLIMITED - on ours the default was still 1 day, and it killed
# a 100-epoch run at epoch 52. Slurm's syntax; '3-00:00:00' is three days.
#SLURM_TIME=
# A run on a model backend that can resume (its /v1/info says train.resume) is resubmitted
# from its last checkpoint when it hits that walltime, up to this many times, before it
# fails as a timeout. 0 turns resuming off.
#SLURM_MAX_RESUMES=3
#SLURM_REMOTE_DIR=deeplabel-trainings
# How fast a snapshot may be pushed to the cluster. A snapshot is hundreds of gigabytes and
# travels the same uplink as ssh and the browser; unthrottled it takes the machine off the
# network until it finishes. rsync's syntax - '5m' is 5 MiB/s. Empty means no limit.
#SLURM_RSYNC_BWLIMIT=5m
# The most memory one evaluation may hold before the app stops it. Unset means half of this
# host's RAM. It exists because an unbounded run reached 54 GB and the kernel answered by
# killing the largest process on the machine - which could as easily have been the backend.
#EVAL_MEMORY_LIMIT_GB=16
# Seconds without any I/O before a transfer counts as stalled, and the wall-clock ceiling
# for one. The second only has to exceed the largest snapshot a slow link can carry.
#SLURM_RSYNC_STALL=600
#SLURM_RSYNC_TIMEOUT=86400
# Key path on this host (mounted into the container) and the mounted path the app uses
#SLURM_SSH_KEY_HOST=/home/youruser/.ssh/id_ed25519
#SLURM_SSH_KEY=/run/secrets/slurm_key
# Socket for the multiplexed ssh master. A cluster that also demands a second factor
# (AuthenticationMethods publickey,keyboard-interactive) cannot be reached by a key
# alone: unlock it once from the training dialog, which relays the cluster's own
# prompt, and every later submit and status poll reuses this socket until the backend
# restarts. Where the key alone is accepted, nothing needs unlocking.
#SLURM_CONTROL_PATH=/tmp/deeplabel-slurm.sock
